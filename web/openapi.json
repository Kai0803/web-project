  "components": {
    "schemas": {
      "CompanyProfileBody": {
        "type": "object",
        "required": [
          "name",
          "quote_terms"
        ],
        "properties": {
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "fax": {
            "type": [
              "string",
              "null"
            ]
