          "logo_svg": {
            "type": [
              "string",
              "null"
            ],
            "description": "Logo 的 SVG 原始碼。網頁與報價單 PDF 共用同一份。"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote_terms": {
            "type": "string",
            "description": "報價單條款，逐字印在報價單末頁。"
          },
          "tax_id": {
            "type": [
              "string",
