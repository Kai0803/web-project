{
  "openapi": "3.1.0",
  "info": {
    "title": "空調配管工程管理系統 API",
    "description": "第一階段：客戶、專案、報價單、合約。\n\n所有金額與數量皆以**字串**傳遞，避免 JSON number 的浮點精度問題。\n\n認證使用 HttpOnly cookie session；所有會改變資料的請求需帶 `X-Requested-With` 標頭（CSRF 防護）。",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "登入成功，session 寫入 cookie"
          },
          "401": {
            "description": "帳號或密碼錯誤"
          },
          "403": {
            "description": "帳號已停用"
          }
        }
      }
    },
