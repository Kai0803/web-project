{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo clippy:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo deny check:*)",
      "Bash(cargo fmt --check:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(tsc --noEmit:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npm audit:*)",
      "Bash(npm run lint:*)"
    ]
  }
}
