<%- include('../partials/head', { title }) %>
<% if (forced) { %>
  <%- include('../partials/public-nav', { user: null }) %>
<% } else { %>
  <%- include('../partials/admin-nav', { user, active: '' }) %>
<% } %>

<section class="section narrow">
  <h1>變更密碼</h1>

  <% if (forced) { %>
    <div class="flash flash-error">
      您目前使用的是預設密碼，請先設定新密碼才能使用系統。
    </div>
  <% } %>

  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

  <form method="POST" action="/change-password" class="form">
    <%- include("../partials/csrf") %>
    <div class="form-row">
      <label>目前密碼</label>
      <input type="password" name="current_password" required autofocus>
    </div>
    <div class="form-row">
      <label>新密碼</label>
      <input type="password" name="new_password" minlength="8" required>
      <span class="muted">至少 8 個字元</span>
    </div>
    <div class="form-row">
      <label>再次輸入新密碼</label>
      <input type="password" name="confirm_password" minlength="8" required>
    </div>
    <button type="submit" class="btn btn-primary btn-large">更新密碼</button>
  </form>
</section>

<%- include('../partials/foot') %>
