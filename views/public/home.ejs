<%- include('../partials/head', { title }) %>
<%- include('../partials/public-nav', { user }) %>

<section class="hero">
  <div class="hero-inner">
    <h1>專業冷氣安裝・清洗・維修</h1>
    <p>服務區域涵蓋住宅與商辦，提供分離式 / 窗型冷氣清洗保養、故障維修、新機安裝。線上預約，快速安排師傅到府服務。</p>
    <a class="btn btn-primary btn-large" href="/booking">立即線上預約</a>
    <a class="btn btn-outline btn-large" href="/booking/lookup">查詢我的預約</a>
  </div>
</section>

<section class="section">
  <h2>服務項目</h2>
  <% Object.keys(grouped).forEach(function(category) { %>
    <h3 class="category-title"><%= category %></h3>
    <div class="card-grid">
      <% grouped[category].forEach(function(item) { %>
        <div class="card">
          <h4><%= item.name %></h4>
          <p class="price"><%= formatMoney(item.base_price) %> / <%= item.unit %></p>
          <p class="muted"><%= item.note || '&nbsp;' %></p>
        </div>
      <% }) %>
    </div>
  <% }) %>
</section>

<section class="section cta-section">
  <h2>需要預約師傅到府服務嗎？</h2>
  <a class="btn btn-primary btn-large" href="/booking">前往預約表單</a>
</section>

<%- include('../partials/foot') %>
