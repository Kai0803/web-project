<%- include('../partials/head', { title }) %>
<%- include('../partials/admin-nav', { user, active }) %>

<section class="section">
  <a href="/admin/orders" class="back-link">&larr; 返回工單列表</a>
  <h1>工單 <%= order.booking_code %>
    <span class="badge <%= STATUS_BADGE_CLASS[order.status] %>"><%= STATUS_LABELS[order.status] %></span>
  </h1>

  <div class="detail-grid">
    <div class="card">
      <h3>客戶資訊</h3>
      <p><strong>姓名：</strong><%= order.customer_name %></p>
      <p><strong>電話：</strong><a href="tel:<%= order.phone.replace(/[^0-9+]/g, '') %>"><%= order.phone %></a></p>
      <p><strong>地址：</strong><a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(order.address) %>" target="_blank" rel="noopener"><%= order.address %></a></p>
      <p><strong>希望日期/時段：</strong><%= order.preferred_date %> ・ <%= order.preferred_time %></p>
      <% if (order.note) { %><p><strong>備註：</strong><%= order.note %></p><% } %>
      <p><strong>建立時間：</strong><%= order.created_at %></p>
      <% if (order.completed_at) { %><p><strong>完工時間：</strong><%= order.completed_at %></p><% } %>

      <!-- 現場單手操作用的快捷鍵 -->
      <div class="quick-actions">
        <a class="btn btn-large" href="tel:<%= order.phone.replace(/[^0-9+]/g, '') %>">📞 撥號</a>
        <a class="btn btn-large" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(order.address) %>" target="_blank" rel="noopener">🗺️ 導航</a>
        <% if (order.status === 'scheduled') { %>
          <form method="POST" action="/admin/orders/<%= order.id %>/status" class="inline-form">
            <%- include("../partials/csrf") %>
            <input type="hidden" name="status" value="in_progress">
            <button type="submit" class="btn btn-large btn-primary">▶ 開始服務</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="card">
      <h3>排程與指派</h3>
      <% if (user.role === 'admin') { %>
        <form method="POST" action="/admin/orders/<%= order.id %>/assign" class="form">
          <%- include("../partials/csrf") %>
          <div class="form-row">
            <label>指派工程師</label>
            <select name="assigned_engineer_id">
              <option value="">未指派</option>
              <% engineers.forEach(function(e) { %>
                <option value="<%= e.id %>" <%= order.assigned_engineer_id === e.id ? 'selected' : '' %>><%= e.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-row">
            <label>排定日期</label>
            <input type="date" name="scheduled_date" value="<%= order.scheduled_date || '' %>">
          </div>
          <div class="form-row">
            <label>排定時段</label>
            <input type="text" name="scheduled_time" value="<%= order.scheduled_time || '' %>" placeholder="例如 上午 09:00-12:00">
          </div>
          <button type="submit" class="btn btn-primary">儲存排程</button>
        </form>
      <% } else { %>
        <p><strong>工程師：</strong><%= engineer ? engineer.name : '未指派' %></p>
        <p><strong>排定日期/時段：</strong><%= order.scheduled_date || '未排定' %> <%= order.scheduled_time || '' %></p>
      <% } %>

      <h4>更新狀態</h4>
      <form method="POST" action="/admin/orders/<%= order.id %>/status" class="inline-form">
        <%- include("../partials/csrf") %>
        <select name="status">
          <% var allowed = user.role === 'admin' ? Object.keys(STATUS_LABELS) : ['in_progress', 'completed']; %>
          <% allowed.forEach(function(s) { %>
            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= STATUS_LABELS[s] %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-small">更新狀態</button>
      </form>

      <% if (user.role === 'admin' && order.status !== 'cancelled' && order.status !== 'completed') { %>
        <form method="POST" action="/admin/orders/<%= order.id %>/cancel" class="inline-form" data-confirm="確定要取消此工單嗎？">
          <%- include("../partials/csrf") %>
          <button type="submit" class="btn btn-small btn-danger">取消工單</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h3>服務項目（工項）</h3>
    <table class="table">
      <thead><tr><th>項目</th><th>數量</th><th>單價</th><th>小計</th><% if (user.role === 'admin') { %><th></th><% } %></tr></thead>
      <tbody>
        <% orderItems.forEach(function(it) { %>
          <tr>
            <td><%= it.name_snapshot %></td>
            <td><%= it.qty %></td>
            <td><%= formatMoney(it.unit_price) %></td>
            <td><%= formatMoney(it.unit_price * it.qty) %></td>
            <% if (user.role === 'admin') { %>
              <td>
                <form method="POST" action="/admin/orders/<%= order.id %>/items/<%= it.id %>/remove" data-confirm="移除此項目？">
                  <%- include("../partials/csrf") %>
                  <button type="submit" class="btn btn-small btn-danger">移除</button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (user.role === 'admin') { %>
      <form method="POST" action="/admin/orders/<%= order.id %>/items/add" class="inline-form">
        <%- include("../partials/csrf") %>
        <select name="service_item_id">
          <% serviceItems.forEach(function(si) { %>
            <option value="<%= si.id %>"><%= si.name %>（<%= formatMoney(si.base_price) %>）</option>
          <% }) %>
        </select>
        <input type="number" name="qty" value="1" min="1" style="width:70px">
        <button type="submit" class="btn btn-small">新增項目</button>
      </form>
    <% } %>
  </div>

  <div class="card">
    <h3>使用零件</h3>
    <% if (typeof partError !== 'undefined' && partError) { %>
      <div class="flash flash-error"><%= partError %></div>
    <% } %>
    <table class="table">
      <thead><tr><th>零件</th><th>數量</th><th>單價</th><th>小計</th><th></th></tr></thead>
      <tbody>
        <% orderParts.forEach(function(op) { %>
          <tr>
            <td><%= op.name_snapshot %></td>
            <td><%= op.qty %></td>
            <td><%= formatMoney(op.unit_price) %></td>
            <td><%= formatMoney(op.unit_price * op.qty) %></td>
            <td>
              <form method="POST" action="/admin/orders/<%= order.id %>/parts/<%= op.id %>/remove" data-confirm="移除此零件使用紀錄？（庫存將歸還）">
                <%- include("../partials/csrf") %>
                <button type="submit" class="btn btn-small btn-danger">移除</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <form method="POST" action="/admin/orders/<%= order.id %>/parts/add" class="inline-form">
      <%- include("../partials/csrf") %>
      <select name="part_id">
        <% parts.forEach(function(p) { %>
          <option value="<%= p.id %>"><%= p.name %>（庫存 <%= p.stock_qty %> <%= p.unit %>）</option>
        <% }) %>
      </select>
      <input type="number" name="qty" value="1" min="1" style="width:70px">
      <button type="submit" class="btn btn-small">登記使用零件</button>
    </form>
  </div>

  <div class="card">
    <h3>施工照片</h3>
    <% if (photoError) { %><div class="flash flash-error"><%= photoError %></div><% } %>

    <% if (photos.length === 0) { %>
      <p class="muted">尚未上傳照片。建議至少拍攝施工前、施工後各一張，作為完工證明。</p>
    <% } else { %>
      <% ['before', 'after', 'other'].forEach(function(kind) { %>
        <% var group = photos.filter(function(p) { return p.kind === kind; }); %>
        <% if (group.length) { %>
          <h4><%= kind === 'before' ? '施工前' : (kind === 'after' ? '施工後' : '其他') %></h4>
          <div class="photo-grid">
            <% group.forEach(function(p) { %>
              <figure class="photo-item">
                <a href="/admin/orders/<%= order.id %>/photos/<%= p.id %>" target="_blank" rel="noopener">
                  <img src="/admin/orders/<%= order.id %>/photos/<%= p.id %>" alt="<%= p.caption || '施工照片' %>" loading="lazy">
                </a>
                <figcaption>
                  <% if (p.caption) { %><span><%= p.caption %></span><% } %>
                  <form method="POST" action="/admin/orders/<%= order.id %>/photos/<%= p.id %>/delete" class="inline-form" data-confirm="確定刪除這張照片？">
                    <%- include("../partials/csrf") %>
                    <button type="submit" class="btn btn-small btn-danger">刪除</button>
                  </form>
                </figcaption>
              </figure>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% } %>

    <form method="POST" action="/admin/orders/<%= order.id %>/photos" enctype="multipart/form-data" class="form">
      <%- include("../partials/csrf") %>
      <div class="form-row">
        <label>拍攝階段</label>
        <select name="kind">
          <option value="before">施工前</option>
          <option value="after">施工後</option>
          <option value="other">其他</option>
        </select>
      </div>
      <div class="form-row">
        <label>說明（選填）</label>
        <input type="text" name="caption" maxlength="200" placeholder="例如：客廳室內機濾網">
      </div>
      <div class="form-row">
        <label>選擇照片（可一次多張，單張上限 8MB）</label>
        <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" capture="environment" multiple required>
      </div>
      <button type="submit" class="btn btn-primary btn-large">上傳照片</button>
    </form>
  </div>

  <div class="card">
    <h3>客戶完工簽收</h3>
    <% if (signature) { %>
      <p class="muted">客戶已於 <%= signature.created_at %> 簽收</p>
      <img class="signature-image" src="/admin/orders/<%= order.id %>/photos/<%= signature.id %>" alt="客戶簽名">
    <% } else if (order.status === 'cancelled') { %>
      <p class="muted">此工單已取消。</p>
    <% } else { %>
      <p class="muted">請客戶在下方簽名確認完工，送出後工單將標記為「已完成」。</p>
      <div class="signature-pad-wrapper">
        <canvas id="signature-pad" class="signature-pad" width="600" height="220"></canvas>
      </div>
      <form method="POST" action="/admin/orders/<%= order.id %>/signature" id="signature-form" class="inline-form">
        <%- include("../partials/csrf") %>
        <input type="hidden" name="signature" id="signature-data">
        <button type="button" class="btn btn-small" id="signature-clear">清除重簽</button>
        <button type="submit" class="btn btn-primary btn-large">確認完工並送出簽名</button>
      </form>
    <% } %>
  </div>

  <div class="card total-card">
    <h3>預估總金額：<%= formatMoney(order.total_amount) %></h3>
  </div>
</section>

<%- include('../partials/foot') %>
