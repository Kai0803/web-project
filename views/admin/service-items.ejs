<%- include('../partials/head', { title }) %>
<%- include('../partials/admin-nav', { user, active }) %>

<section class="section">
  <h1>服務項目（工項）管理</h1>

  <div class="detail-grid">
    <div class="card">
      <h3><%= editItem ? '編輯項目' : '新增項目' %></h3>
      <form method="POST" action="<%= editItem ? '/admin/service-items/' + editItem.id : '/admin/service-items' %>" class="form">
        <div class="form-row">
          <label>名稱</label>
          <input type="text" name="name" value="<%= editItem ? editItem.name : '' %>" required>
        </div>
        <div class="form-row">
          <label>分類</label>
          <input type="text" name="category" value="<%= editItem ? editItem.category : '清洗保養' %>">
        </div>
        <div class="form-row">
          <label>單位</label>
          <input type="text" name="unit" value="<%= editItem ? editItem.unit : '次' %>">
        </div>
        <div class="form-row">
          <label>價格</label>
          <input type="number" name="base_price" value="<%= editItem ? editItem.base_price : 0 %>" min="0" step="1">
        </div>
        <div class="form-row">
          <label>預估時長（分鐘）</label>
          <input type="number" name="est_minutes" value="<%= editItem ? editItem.est_minutes : 60 %>" min="1">
        </div>
        <div class="form-row">
          <label class="checkbox-item">
            <input type="checkbox" name="is_public" value="1" <%= (!editItem || editItem.is_public) ? 'checked' : '' %>>
            開放客戶於線上預約選擇
          </label>
        </div>
        <div class="form-row">
          <label>備註</label>
          <textarea name="note" rows="2"><%= editItem ? (editItem.note || '') : '' %></textarea>
        </div>
        <button type="submit" class="btn btn-primary"><%= editItem ? '儲存變更' : '新增項目' %></button>
        <% if (editItem) { %><a class="btn btn-outline" href="/admin/service-items">取消編輯</a><% } %>
      </form>
    </div>

    <div class="card">
      <h3>項目列表</h3>
      <table class="table">
        <thead><tr><th>名稱</th><th>分類</th><th>價格</th><th>公開</th><th></th></tr></thead>
        <tbody>
          <% items.forEach(function(it) { %>
            <tr>
              <td><%= it.name %></td>
              <td><%= it.category %></td>
              <td><%= formatMoney(it.base_price) %> / <%= it.unit %></td>
              <td><%= it.is_public ? '是' : '否' %></td>
              <td>
                <a class="btn btn-small" href="/admin/service-items/<%= it.id %>/edit">編輯</a>
                <form method="POST" action="/admin/service-items/<%= it.id %>/delete" class="inline-form" onsubmit="return confirm('確定刪除此項目？');">
                  <button type="submit" class="btn btn-small btn-danger">刪除</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
